// ─── Salon Quote Request (demande de devis) ──────────────────────────────────

// ─── Précommandes ────────────────────────────────────────────────────────────

/**
 * Réservation d'un produit pas encore sorti. Volontairement séparée des
 * commandes : aucun paiement, aucune adresse — le client est rappelé. Le prix
 * et le nom du produit sont recopiés à la soumission pour que la demande reste
 * lisible même si le produit change de tarif ou est supprimé ensuite.
 */
model PreorderRequest {
  id            String         @id @default(cuid())
  name          String
  phone         String
  deliveryPlace String?
  /// Conservés pour les demandes reçues avant le retrait de ces champs du formulaire.
  email         String?
  message       String?        @db.Text
  status        PreorderStatus @default(NEW)
  adminNote     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items PreorderRequestItem[]

  @@index([status])
  @@map("preorder_requests")
}

/// Une ligne de précommande. Nom, prix et date de sortie sont recopiés à la
/// soumission : la demande reste lisible même si le produit change ou disparaît.
model PreorderRequestItem {
  id          String    @id @default(cuid())
  requestId   String
  productId   String?
  productName String
  unitPrice   Decimal   @db.Decimal(12, 2)
  releaseDate DateTime?
  color       String?
  quantity    Int       @default(1)

  request PreorderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("preorder_request_items")
}

model QuoteRequest {
  id        String      @id @default(cuid())
  name      String
  phone     String
  email     String?
  services  Json
  occasion  String?
  eventDate DateTime?
  location  String      @default("salon")
  guests    Int         @default(1)
  budget    String?
  message   String?     @db.Text
  status    QuoteStatus @default(NEW)
  adminNote String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@map("quote_requests")
}

/// Inscrits à la communauté Willy : notifications, promotions et jeux.
/// Le téléphone est la clé (WhatsApp = canal principal de la boutique), donc
/// unique : une seconde inscription avec le même numéro met à jour la fiche
/// au lieu de créer un doublon. L'e-mail reste facultatif.
model Subscriber {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("subscribers")
}
