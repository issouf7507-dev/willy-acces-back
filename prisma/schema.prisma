generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// Trois rôles de back-office, du moins au plus puissant :
/// VENDEUR tient le comptoir, ADMIN pilote tout le site et la gestion à
/// l'exception des écrans d'argent, SUPER_ADMIN voit et fait tout.
enum Role {
  CUSTOMER
  VENDEUR
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum InventoryMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  /// Déplacement entre boutiques : deux mouvements, un négatif au départ et un
  /// positif à l'arrivée, portant la même référence.
  TRANSFER
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum PreorderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
}

enum StoreType {
  PHYSICAL
  ONLINE
}

/// Cycle de vie d'un arrivage. Rien n'entre en stock tant qu'il est en
/// brouillon ; la réception est le seul moment où les quantités et le coût de
/// revient sont figés.
enum ShipmentStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

/// Origine d'une vente. `ONLINE` = commande passée depuis le site,
/// `IN_STORE` = vente au comptoir saisie par une vendeuse.
enum SalesChannel {
  ONLINE
  IN_STORE
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  password  String
  isActive  Boolean  @default(true)
  /// Boutique de rattachement du personnel (null pour un CUSTOMER, ou pour un
  /// administrateur qui n'est affecté à aucun point de vente).
  storeId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  addresses Address[]
  /// Commandes passées *par* cet utilisateur en tant que client.
  orders    Order[]   @relation("OrderCustomer")
  /// Ventes réalisées *par* cet utilisateur en tant que vendeur.
  soldOrders Order[]  @relation("OrderSeller")
  reviews   Review[]
  cart      Cart?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customer  Customer?
  priceChanges PriceHistory[]

  @@index([storeId])
  stockTransfers StockTransfer[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  providerId        String
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerAccountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("verifications")
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  district   String?
  country    String  @default("Côte d'Ivoire")
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  parentId    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  couponCategories CouponCategory[]

  @@map("categories")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.LongText
  shortDescription String?  @db.Text
  categoryId       String?
  // Prix normal du produit. Jamais réécrit par le mécanisme de promotion :
  // c'est lui qui s'affiche barré pendant une promo, et qui redevient seul
  // prix affiché une fois la promo terminée.
  price            Decimal  @db.Decimal(12, 2)
  // Promotion planifiée : `promoPrice` s'applique entre `promoStartsAt` et
  // `promoEndsAt`. Début vide = démarre immédiatement ; fin vide = sans
  // échéance. Rien n'est modifié en base au fil du temps : la fenêtre s'ouvre
  // et se referme d'elle-même (voir modules/products/promo.ts).
  promoPrice       Decimal? @db.Decimal(12, 2)
  promoStartsAt    DateTime?
  promoEndsAt      DateTime?
  costPrice        Decimal? @db.Decimal(12, 2)
  sku              String?  @unique
  barcode          String?
  trackInventory   Boolean  @default(true)
  stock            Int      @default(0)
  lowStockAlert    Int      @default(5)
  weight           Decimal? @db.Decimal(8, 3)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  isNew            Boolean  @default(false)
  isPreorder       Boolean  @default(false)
  // Fenêtre de précommande : les commandes ouvrent à `preorderStartsAt` (vide =
  // ouvertes immédiatement) et se ferment à `releaseDate`, qui est aussi la date
  // de sortie annoncée. Passée cette date, le produit se vend normalement.
  // Comme pour les promos, rien n'est réécrit en base : l'état se déduit de
  // l'heure courante (voir modules/products/preorder.ts).
  preorderStartsAt DateTime?
  releaseDate      DateTime?
  // Prix appliqué pendant la précommande. Vide = c'est le prix normal qui
  // s'applique. À la sortie, le prix normal reprend la main.
  preorderPrice    Decimal? @db.Decimal(12, 2)
  tags             String?  @db.Text
  // Lien vers une vidéo TikTok présentant le produit (facultatif). Affiché en
  // fiche produit quand il est renseigné ; aucun embed, un simple lien sortant.
  tiktokUrl        String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  seoKeywords      String?  @db.Text
  currency         String   @default("FCFA")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category?        @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  reviews          Review[]
  inventoryHistory Inventory[]

  couponProducts   CouponProduct[]
  campaignProducts CampaignProduct[]
  preorderItems    PreorderRequestItem[]
  shipmentItems    ShipmentItem[]
  priceHistory     PriceHistory[]

  @@fulltext([name, description])
  storeStocks  StoreStock[]
  transfers    StockTransfer[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  options        Json
  sku            String?  @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  isDefault      Boolean  @default(false)
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  cartItems        CartItem[]
  inventoryHistory Inventory[]

  @@map("product_variants")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Inventory {
  id        String                @id @default(cuid())
  productId String
  variantId String?
  /// Boutique où le mouvement a lieu. Null pour les mouvements écrits avant la
  /// tenue du stock par boutique.
  storeId   String?
  quantity  Int
  type      InventoryMovementType
  note      String?               @db.Text
  reference String?
  createdAt DateTime              @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  store   Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("inventory_movements")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  addressId       String?
  /// Boutique où la vente a eu lieu. Les commandes du site pointent la boutique
  /// de type ONLINE : recettes, objectifs et comparatif traitent ainsi le web
  /// comme un point de vente parmi les autres, sans double saisie.
  storeId         String?
  /// Vendeuse ayant encaissé (ventes comptoir uniquement).
  sellerId        String?
  /// Client de comptoir, quand il n'a pas de compte sur le site.
  customerId      String?
  channel         SalesChannel @default(ONLINE)
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("FCFA")
  couponId        String?
  notes           String?     @db.Text
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?     @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  seller   User?     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  store    Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon   Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?

  @@index([storeId, createdAt])
  @@index([sellerId])
  @@index([customerId])
  @@index([channel])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  name      String
  sku       String?
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  /// Réduction accordée sur cette ligne, hors coupon. `total` est déjà net de
  /// cette remise : c'est le prix réellement payé, la base de tous les calculs
  /// de recette et de marge.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Motif libre de la remise (« Client fidèle », « Fin de série »…), repris
  /// tel quel dans les rapports.
  discountReason String?
  total     Decimal @db.Decimal(12, 2)
  options   Json?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("FCFA")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CASH)
  transactionId String?
  metadata      Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  /// Null pour un avis déposé depuis la boutique sans compte : c'est
  /// `authorName` qui porte alors le nom saisi par le visiteur.
  userId     String?
  productId  String
  authorName String?
  rating     Int
  title      String?
  body       String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // MySQL autorise plusieurs NULL : la contrainte ne vise que les avis de
  // comptes (un seul avis par client et par produit).
  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@map("reviews")
}

// ─── Coupon ──────────────────────────────────────────────────────────────────

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Decimal    @db.Decimal(10, 2)
  minPurchase     Decimal?   @db.Decimal(12, 2)
  maxDiscount     Decimal?   @db.Decimal(12, 2)
  usageLimit      Int?
  usedCount       Int        @default(0)
  perUserLimit    Int?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orders     Order[]
  categories CouponCategory[]
  products   CouponProduct[]

  @@map("coupons")
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

// ─── Campaign ────────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  type        CampaignType
  subject     String?
  content     String         @db.LongText
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products CampaignProduct[]

  @@map("campaigns")
}

model CampaignProduct {
  campaignId String
  productId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@map("campaign_products")
}

// ─── Gestion : arrivages (cargo) ─────────────────────────────────────────────

/// Lot expédié ensemble depuis le fournisseur, avec un seul coût de transport.
/// C'est le « groupe » du suivi Excel (G1, G2…) : le transport du lot est
/// réparti à l'unité sur les articles reçus, ce qui donne le vrai coût de
/// revient — celui que le fichier Excel oubliait dans ses marges.
model Shipment {
  id           String         @id @default(cuid())
  code         String         @unique
  label        String?
  /// Transport du lot entier, réparti sur la quantité totale reçue.
  shippingCost Decimal        @default(0) @db.Decimal(12, 2)
  currency     String         @default("FCFA")
  status       ShipmentStatus @default(DRAFT)
  /// Boutique vers laquelle part le lot par défaut. Chaque ligne peut la
  /// remplacer : un même arrivage se partage parfois entre boutiques.
  storeId      String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items ShipmentItem[]
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([storeId])
  @@map("shipments")
}

/// Une ligne de produit reçue dans un arrivage.
///
/// `unitShipping` et `landedCost` sont vides tant que l'arrivage est en
/// brouillon, puis figés à la réception : recalculer le coût de revient a
/// posteriori réécrirait la marge de ventes déjà enregistrées.
model ShipmentItem {
  id           String   @id @default(cuid())
  shipmentId   String
  productId    String
  /// Boutique créditée à la réception. Reprise du lot par défaut, modifiable
  /// ligne par ligne quand l'arrivage se partage.
  storeId      String
  quantity     Int
  /// Prix d'achat unitaire, hors transport.
  unitCost     Decimal  @db.Decimal(12, 2)
  /// Prix de vente envisagé à la commande. Purement indicatif : il ne modifie
  /// jamais le prix affiché en boutique, qui reste piloté depuis Produits.
  plannedPrice Decimal? @db.Decimal(12, 2)
  /// Quote-part de transport, figée à la réception.
  unitShipping Decimal? @db.Decimal(12, 2)
  /// Coût de revient unitaire figé à la réception (achat + transport).
  landedCost   Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])

  /// Un produit n'apparaît qu'une fois par arrivage **et par boutique** : deux
  /// lignes identiques fausseraient le suivi, mais 6 tables à la Palmeraie et
  /// 4 à Cocody dans le même lot sont deux lignes légitimes.
  @@unique([shipmentId, productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@map("shipment_items")
}

// ─── Gestion : historique des prix ───────────────────────────────────────────

/// Trace d'un changement de prix de vente. Écrite automatiquement à chaque
/// modification depuis le back-office : dans le classeur, cette ligne était à
/// saisir à la main et ne l'était donc jamais.
///
/// Seul le prix normal est suivi ; promotions et prix de précommande sont des
/// fenêtres datées, déjà lisibles sur la fiche produit.
model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedById String?
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("price_history")
}

// ─── Gestion : dépenses et clôture mensuelle ─────────────────────────────────

/// Dépense imprévue, au jour le jour. Distincte des charges obligatoires du
/// mois, qui vivent sur `MonthlyClosing` : celles-ci sont récurrentes et
/// connues d'avance, celles-là ne le sont pas.
model Expense {
  id        String   @id @default(cuid())
  date      DateTime
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  /// Boutique concernée, quand la dépense en vise une en particulier.
  storeId   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([storeId])
  @@map("expenses")
}

/// Clôture d'un mois. Seules les cinq charges obligatoires et le taux de
/// répartition sont saisis ; recettes, dépenses annexes, bénéfice, réserve et
/// répartition Achats/Épargne se calculent — les stocker les figerait alors
/// qu'une vente peut encore être enregistrée sur le mois.
model MonthlyClosing {
  id             String   @id @default(cuid())
  /// Mois au format `YYYY-MM`, comme dans le suivi Excel.
  month          String   @unique
  rent           Decimal  @default(0) @db.Decimal(12, 2)
  salaries       Decimal  @default(0) @db.Decimal(12, 2)
  utilities      Decimal  @default(0) @db.Decimal(12, 2)
  transportTaxes Decimal  @default(0) @db.Decimal(12, 2)
  other          Decimal  @default(0) @db.Decimal(12, 2)
  /// Part du reste affectée aux achats ; le complément va à l'épargne.
  purchaseRate   Decimal  @default(0.65) @db.Decimal(5, 4)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monthly_closings")
}

/// Cible de recette pour un mois et une boutique. Le réalisé n'est pas stocké :
/// il se lit sur les ventes du mois, donc il reste juste même si une vente est
/// enregistrée après coup.
model SalesTarget {
  id        String   @id @default(cuid())
  month     String
  storeId   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([month, storeId])
  @@index([month])
  @@map("sales_targets")
}

// ─── Gestion : boutiques et clients de comptoir ──────────────────────────────

/// Point de vente. Le site est lui-même une boutique (type ONLINE), pour que
/// recettes, objectifs et comparatifs traitent le web et le comptoir de la même
/// manière. Sans cette entité, aucun chiffre ne peut être ventilé par boutique.
model Store {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  type      StoreType @default(PHYSICAL)
  address   String?
  phone     String?
  /// Boutique qui récupère automatiquement les commandes passées sur le site.
  /// Une seule doit porter ce drapeau ; le service s'en assure à l'écriture.
  isDefaultOnline Boolean @default(false)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  staff    User[]
  orders   Order[]
  expenses Expense[]
  targets  SalesTarget[]
  stocks   StoreStock[]
  shipments Shipment[]
  shipmentItems ShipmentItem[]
  movements     Inventory[]
  transfersOut  StockTransfer[] @relation("TransferFrom")
  transfersIn   StockTransfer[] @relation("TransferTo")

  @@map("stores")
}

/// Stock d'un produit dans une boutique.
///
/// `Product.stock` reste le **total** de l'entreprise, maintenu en parallèle :
/// c'est lui que lisent la boutique en ligne, le panier et les fiches produit.
/// Ces lignes en donnent la répartition, sans laquelle ni la recette d'une
/// boutique ni ses alertes de réappro ne veulent dire grand-chose.
model StoreStock {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("store_stocks")
}

/// Déplacement de marchandise d'une boutique à une autre.
///
/// Sans cette trace, un carton déplacé rend faux le stock des deux boutiques
/// sans qu'aucun écran ne puisse l'expliquer. Le total de l'entreprise, lui,
/// ne bouge pas : `Product.stock` est inchangé par un transfert.
model StockTransfer {
  id          String   @id @default(cuid())
  productId   String
  fromStoreId String
  toStoreId   String
  quantity    Int
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStore Store   @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore   Store   @relation("TransferTo", fields: [toStoreId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("stock_transfers")
}

/// Client de comptoir, sans compte sur le site. Le téléphone sert d'identité,
/// comme pour `Subscriber` (WhatsApp est le canal principal de la boutique).
/// `userId` relie la fiche au compte client si la personne finit par en créer un,
/// pour que son historique reste d'un seul tenant.
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  notes     String?  @db.Text
  userId    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([name])
  @@map("customers")
}

